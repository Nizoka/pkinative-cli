{
  "schemaVersion": 1,
  "pkinative": "1.0.0",
  "cliCodes": [
    {
      "code": "E_USAGE",
      "meaning": "A flag, argument or option value is missing or invalid (exit 2)."
    },
    {
      "code": "E_INPUT",
      "meaning": "A value you supplied is not acceptable: a spec document, a label, a range, a key that does not match."
    },
    {
      "code": "E_PARSE",
      "meaning": "The bytes are not the DER, PEM or JSON structure they claim to be."
    },
    {
      "code": "E_IO",
      "meaning": "A filesystem or stream failure, including a refused overwrite."
    },
    {
      "code": "E_SECURITY",
      "meaning": "A security policy refused the input: SHA-1 without --allow-sha1, PBES1, a legacy PKCS#12 MAC."
    },
    {
      "code": "E_LIMIT",
      "meaning": "A named bound was exceeded: one of the 22 pkinative limits, or --max-content-size."
    },
    {
      "code": "E_UNSUPPORTED",
      "meaning": "The runtime or pkinative does not support the algorithm, key or structure."
    },
    {
      "code": "E_CRYPTO",
      "meaning": "Web Crypto could not run the operation the input requires."
    },
    {
      "code": "E_PASSWORD",
      "meaning": "A password is wrong, or a MAC does not match it."
    },
    {
      "code": "E_NOT_FOUND",
      "meaning": "A named item does not exist: an extension, a PEM block, a signer, a code."
    },
    {
      "code": "E_VERIFY_FAILED",
      "meaning": "A signature, chain, request, time-stamp or MAC verdict is negative; the report says why."
    },
    {
      "code": "E_CHECK_FAILED",
      "meaning": "A check returned reasons (revocation, OCSP, name, purpose) or --strict escalated a warning."
    },
    {
      "code": "E_RUNTIME",
      "meaning": "Anything else (exit 1); PKINATIVE_DEBUG=1 prints the stack."
    }
  ],
  "pkiToCli": [
