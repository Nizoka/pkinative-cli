{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "env": {
    "BASH_MAX_OUTPUT_LENGTH": "16000",
    "BASH_DEFAULT_TIMEOUT_MS": "300000",
    "BASH_MAX_TIMEOUT_MS": "1800000",
    "NO_COLOR": "1"
  },
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npx vitest *)",
      "Bash(npx tsx scripts/*)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git check-ignore *)",
      "Bash(node -e *)",
      "Bash(git ls-files*)",
      "Bash(git rev-parse *)",
      "Bash(git merge-base *)",
      "Bash(git worktree list*)",
      "Bash(git describe*)",
      "Bash(git branch --list*)",
      "Bash(node dist/cli.cjs *)",
      "Bash(git grep *)",
      "Bash(git branch --show-current)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(sed -n *)",
      "PowerShell(npm run *)",
      "PowerShell(npm test*)",
      "PowerShell(npx vitest *)",
      "PowerShell(npx tsx scripts/*)",
      "PowerShell(npx tsc *)",
      "PowerShell(npx eslint *)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "PowerShell(git show*)",
      "PowerShell(git check-ignore *)",
      "PowerShell(node -e *)",
      "PowerShell(git ls-files*)",
      "PowerShell(git rev-parse *)",
      "PowerShell(git merge-base *)",
      "PowerShell(git worktree list*)",
      "PowerShell(git describe*)",
      "PowerShell(git branch --list*)",
      "PowerShell(node dist/cli.cjs *)",
      "PowerShell(git grep *)",
      "PowerShell(git branch --show-current)",
      "PowerShell(ls *)",
      "PowerShell(wc *)",
      "PowerShell(head *)",
      "PowerShell(tail *)",
      "PowerShell(sed -n *)"
    ],
    "deny": [
      "Read(package-lock.json)",
      "Read(coverage/**)",
      "Read(dist/**)",
      "Read(test-output/**)",
      "Read(node_modules/**)",
      "Read(docs/data/pkinative/api.frozen.json)",
      "Bash(npm publish*)",
      "Bash(npm unpublish*)",
      "Bash(npm deprecate*)",
      "Bash(npm dist-tag*)",
      "Bash(npx npm publish*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push *)",
      "Bash(git push)",
      "Bash(git tag -a*)",
      "Bash(git tag -s*)",
      "Bash(git tag -u*)",
      "Bash(git tag -f*)",
      "Bash(git tag -d*)",
      "Bash(git tag -m*)",
      "Bash(git tag --annotate*)",
      "Bash(git tag --sign*)",
      "Bash(git tag --force*)",
      "Bash(git tag --delete*)",
      "Bash(git tag v*)",
      "Bash(gh pr create*)",
      "Bash(gh pr edit*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr close*)",
      "Bash(gh pr comment*)",
      "Bash(gh issue create*)",
      "Bash(gh issue edit*)",
      "Bash(gh issue close*)",
      "Bash(gh issue comment*)",
      "Bash(gh release *)",
      "Bash(gh api *--method POST*)",
      "PowerShell(npm publish*)",
      "PowerShell(npm unpublish*)",
      "PowerShell(npm deprecate*)",
      "PowerShell(npm dist-tag*)",
      "PowerShell(npx npm publish*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push *)",
      "PowerShell(git push)",
      "PowerShell(git tag -a*)",
      "PowerShell(git tag -s*)",
      "PowerShell(git tag -u*)",
      "PowerShell(git tag -f*)",
      "PowerShell(git tag -d*)",
      "PowerShell(git tag -m*)",
      "PowerShell(git tag --annotate*)",
      "PowerShell(git tag --sign*)",
      "PowerShell(git tag --force*)",
      "PowerShell(git tag --delete*)",
      "PowerShell(git tag v*)",
      "PowerShell(gh pr create*)",
      "PowerShell(gh pr edit*)",
      "PowerShell(gh pr merge*)",
      "PowerShell(gh pr close*)",
      "PowerShell(gh pr comment*)",
      "PowerShell(gh issue create*)",
      "PowerShell(gh issue edit*)",
      "PowerShell(gh issue close*)",
      "PowerShell(gh issue comment*)",
      "PowerShell(gh release *)",
      "PowerShell(gh api *--method POST*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
